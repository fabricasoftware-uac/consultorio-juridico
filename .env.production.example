# =====================================================================
# Variables de entorno del FRONTEND en producción (contenedor `web`).
# Copiar a deploy/.env y completar con los valores reales del servidor.
#
# IMPORTANTE: las NEXT_PUBLIC_* se hornean en el bundle durante el build,
# por eso también se pasan como --build-arg. Si cambian, RECONSTRUIR la imagen.
# =====================================================================

# NOTA: el dominio actual (consultorio.emprendelab-web.com) es temporal;
# cuando la universidad asigne el suyo, cambia estos valores y RECONSTRUYE la
# imagen del frontend (las NEXT_PUBLIC_* se hornean en el build).

# --- Cliente (build-time + runtime) ---
# URL pública de la API de Supabase (Kong detrás de Caddy)
NEXT_PUBLIC_SUPABASE_URL=https://api.consultorio.emprendelab-web.com
# ANON_KEY generado para el stack self-hosted (JWT rol anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública del frontend (usada en emails y redirecciones de auth)
NEXT_PUBLIC_SITE_URL=https://consultorio.emprendelab-web.com

# --- Servidor (solo runtime) ---
# SERVICE_ROLE_KEY del stack self-hosted (JWT rol service_role). SECRETO.
NEXT_SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido para autorizar los endpoints /api/cron/* (Bearer).
CRON_SECRET=
# Envío de email transaccional vía Resend.
RESEND_API_KEY=
EMAIL_PROVIDER=RESEND
NOTIFICATIONS_FROM_EMAIL=notificaciones@consultorio.emprendelab-web.com

# --- Dominios / Caddy (usados por deploy/docker-compose.yml y Caddyfile) ---
APP_DOMAIN=consultorio.emprendelab-web.com
API_DOMAIN=api.consultorio.emprendelab-web.com
STUDIO_DOMAIN=studio.consultorio.emprendelab-web.com
# Basic auth para Studio. Generar el hash con: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'TU_CLAVE'
STUDIO_USER=admin
STUDIO_PASSWORD_HASH=

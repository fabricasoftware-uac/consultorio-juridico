# =====================================================================
# Plantilla de variables de entorno (desarrollo local).
# Copiar a .env.local y completar. Estos nombres son los que el código lee.
# Para producción/Docker ver .env.production.example y docs/despliegue-docker.md
# =====================================================================

# --- Supabase (cliente, se exponen al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (servidor, SECRETO — nunca en el cliente) ---
NEXT_SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres (usada solo por tooling/seed, no por el frontend)
NEXT_SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ingreso con Google, estudiantes (los lee supabase/config.toml) ---
# Credenciales de un OAuth Client ID tipo "Web application" de Google Cloud Console.
# Redirect URI autorizado allí para local: http://127.0.0.1:54331/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Cron (endpoints /api/cron/*) ---
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_PROVIDER=RESEND
NOTIFICATIONS_FROM_EMAIL=noreply@consultoriojuridico.app

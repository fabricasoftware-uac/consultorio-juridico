{"nodes": [{"id": "readme_consultorio_juridico", "label": "Consultorio Juridico UAC \u2014 sistema de gestion de casos", "file_type": "document", "source_file": "README.md", "source_location": "L1-L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rbac_tres_capas", "label": "Autorizacion en tres capas (middleware, RLS, token hook)", "file_type": "rationale", "source_file": "README.md", "source_location": "L33-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defensa en profundidad: el middleware bloquea la navegacion, RLS impide que un cliente comprometido lea filas ajenas aun con token valido, y el hook garantiza que el rol viaje firmado dentro del JWT en lugar de ser enviado por el cliente."}, {"id": "readme_rol_admin", "label": "Rol admin (/admin/*)", "file_type": "concept", "source_file": "README.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rol_pro_apoyo", "label": "Rol pro_apoyo (/pro-apoyo/*)", "file_type": "concept", "source_file": "README.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rol_asesor", "label": "Rol asesor (/asesor/*)", "file_type": "concept", "source_file": "README.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rol_estudiante", "label": "Rol estudiante (/estudiante/*)", "file_type": "concept", "source_file": "README.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ciclo_vida_caso", "label": "Ciclo de vida del caso", "file_type": "concept", "source_file": "README.md", "source_location": "L48-L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_entrevista_8_pasos", "label": "Entrevista de 8 pasos (wizard)", "file_type": "rationale", "source_file": "README.md", "source_location": "L134-L144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "22 campos sociodemograficos se parten en 8 pasos para no abrumar al estudiante; el borrador se persiste en localStorage porque la sesion es larga y una recarga perderia toda la captura."}, {"id": "readme_documentos_flujo", "label": "Documentos con flujo de aprobacion", "file_type": "rationale", "source_file": "README.md", "source_location": "L146-L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El asesor aprueba o rechaza cada documento; exigir que todos esten aprobados para cerrar un caso 'En tramite' evita cerrar expedientes incompletos. El bloqueo de carga en casos cerrados/archivados se aplica tanto en UI como en la politica RLS doc_insert_assign para que la restriccion no dependa del cliente."}, {"id": "readme_recordatorio_documentos", "label": "Recordatorio de documentos faltantes (RPC recordar_documentos_caso)", "file_type": "rationale", "source_file": "README.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Limite de un recordatorio cada 24 h para evitar spam del asesor hacia la campanita del estudiante."}, {"id": "readme_llamados_atencion", "label": "Llamados de atencion (business-day-aware)", "file_type": "rationale", "source_file": "README.md", "source_location": "L157-L164", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los plazos se cuentan en dias habiles (3 para estudiante, 2 para asesor) porque el consultorio no opera fines de semana; generar alertas en sabado/domingo produciria llamados injustos."}, {"id": "readme_notificaciones", "label": "Notificaciones en tiempo real y por email", "file_type": "concept", "source_file": "README.md", "source_location": "L166-L171", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_observaciones_chat", "label": "Observaciones (chat interno estudiante-asesor)", "file_type": "concept", "source_file": "README.md", "source_location": "L173-L175", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_auditoria", "label": "Auditoria de casos", "file_type": "concept", "source_file": "README.md", "source_location": "L177-L179", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_analiticas_exportacion", "label": "Analiticas y exportacion Excel", "file_type": "concept", "source_file": "README.md", "source_location": "L181-L184", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_reasignacion_equipo", "label": "Reasignacion de equipo asignado", "file_type": "rationale", "source_file": "README.md", "source_location": "L186-L188", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El selector muestra carga actual, dia y jornada para que quien reasigna balancee la carga en vez de elegir a ciegas."}, {"id": "readme_subida_directa_storage", "label": "Subida directa al Storage para evadir el limite de Vercel", "file_type": "rationale", "source_file": "README.md", "source_location": "L268", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El body de una funcion serverless de Vercel esta limitado a 4.5 MB; subiendo el archivo del cliente directo a Supabase Storage y dejando que la API Route maneje solo metadatos se soportan archivos hasta 25 MB."}], "edges": [{"source": "readme_consultorio_juridico", "target": "readme_ciclo_vida_caso", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme_rbac_tres_capas", "target": "readme_rol_admin", "relation": "references", "confidence": "EXTRACTED",
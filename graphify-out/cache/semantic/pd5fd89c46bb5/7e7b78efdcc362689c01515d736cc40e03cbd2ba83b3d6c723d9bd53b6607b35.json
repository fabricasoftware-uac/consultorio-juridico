d_at": null, "author": null, "contributor": null}, {"id": "docs_ai_contexto_demandados", "label": "Tabla demandados", "file_type": "concept", "source_file": "docs/ai-contexto.md", "source_location": "L162-L171", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_contexto_documentos_caso", "label": "Tabla documentos_caso", "file_type": "rationale", "source_file": "docs/ai-contexto.md", "source_location": "L173-L188", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo guarda metadatos; el binario vive en Supabase Storage bajo {id_caso}/{uuid}.{ext} para que storage.foldername() pueda derivar el id_caso y aplicar RLS sobre storage.objects."}, {"id": "docs_ai_contexto_llamados_atencion", "label": "Tabla llamados_atencion", "file_type": "rationale", "source_file": "docs/ai-contexto.md", "source_location": "L190-L203", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El UNIQUE parcial (id_caso, tipo) WHERE resuelto = false garantiza a nivel de BD un solo llamado abierto por caso y tipo, evitando duplicados si el cron corre varias veces."}, {"id": "docs_ai_contexto_auditoria_casos", "label": "Tabla auditoria_casos", "file_type": "concept", "source_file": "docs/ai-contexto.md", "source_location": "L205-L216", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_contexto_actividades_caso", "label": "Tabla actividades_caso", "file_type": "concept", "source_file": "docs/ai-contexto.md", "source_location": "L218-L226", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_contexto_notificaciones_usuario", "label": "Tabla notificaciones_usuario", "file_type": "concept", "source_file": "docs/ai-contexto.md", "source_location": "L228-L241", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_contexto_notificaciones_pendientes", "label": "Tabla notificaciones_pendientes (cola de emails)", "file_type": "rationale", "source_file": "docs/ai-contexto.md", "source_location": "L243-L257", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cola con estados PENDING -> PROCESSING -> SENT/FAILED y UNIQUE (id_caso, id_usuario, tipo_notificacion): desacopla el envio de email del trigger de asignacion y permite reintentos sin duplicar correos."}, {"id": "docs_ai_contexto_horarios", "label": "Tabla horarios", "file_type": "concept", "source_file": "docs/ai-contexto.md", "source_location": "L259-L265", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_contexto_contratos_laborales", "label": "Tabla contratos_laborales", "file_type": "concept", "source_file": "docs/ai-contexto.md", "source_location": "L267-L280", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_contexto_perfiles_roles", "label": "Tabla perfiles_roles", "file_type": "concept", "source_file": "docs/ai-contexto.md", "source_location": "L349-L350", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_contexto_role_permissions", "label": "Tabla role_permissions (37 permisos)", "file_type": "rationale", "source_file": "docs/ai-contexto.md", "source_location": "L351-L361", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permisos granulares {tabla}.{operacion} en tabla en vez de hardcodear roles en cada politica: cambiar quien puede hacer que es un INSERT, no una migracion de politicas."}, {"id": "docs_ai_contexto_estado_enum", "label": "estado_enum (maquina de estados del caso)", "file_type": "rationale", "source_file": "docs/ai-contexto.md", "source_location": "L286-L287", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historico: 'aprobado' fue renombrado semanticamente a 'activo' (2026
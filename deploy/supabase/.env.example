# =====================================================================
# Variables del stack Supabase self-hosted.
# Punto de partida: el archivo .env del repo oficial (supabase/docker).
# Aquí se listan las claves que DEBES ajustar para este proyecto.
# Copiar a deploy/supabase/.env y completar. NO reutilizar los ejemplos.
# =====================================================================

############ Secretos base ############
POSTGRES_PASSWORD=cambiar-super-secreto
# Cadena aleatoria de >= 40 caracteres. Con ella se firman ANON_KEY y SERVICE_ROLE_KEY.
JWT_SECRET=cambiar-cadena-aleatoria-de-al-menos-40-caracteres
# JWT firmados con JWT_SECRET (roles anon / service_role). Generar con el
# generador de llaves de Supabase (ver docs/despliegue-docker.md).
ANON_KEY=
SERVICE_ROLE_KEY=
# Acceso a Studio (basic auth interno del stack).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambiar

############ Base de datos ############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ URLs públicas ############
# El dominio actual es temporal; cambia estas 4 al reasignar el dominio.
SITE_URL=https://consultorio.emprendelab-web.com
API_EXTERNAL_URL=https://api.consultorio.emprendelab-web.com
SUPABASE_PUBLIC_URL=https://api.consultorio.emprendelab-web.com
ADDITIONAL_REDIRECT_URLS=https://consultorio.emprendelab-web.com/cambiar-contrasena,https://consultorio.emprendelab-web.com/auth/callback

############ Auth (GoTrue) ############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# La app usa enable_confirmations=false → autoconfirmar el email al registrarse.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

############ Ingreso con Google (estudiantes) ############
# Credenciales del OAuth Client ID (tipo "Web application") de Google Cloud Console.
# Redirect URI autorizado allí: ${API_EXTERNAL_URL}/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

############ SMTP de GoTrue ############
# NECESARIO para recuperación de contraseña / cambio de email (no usa Resend API).
# Ejemplo con Resend SMTP:
SMTP_ADMIN_EMAIL=notificaciones@consultorio.emprendelab-web.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=tu_RESEND_API_KEY
SMTP_SENDER_NAME=Consultorio Jurídico UAC

############ Storage ############
FILE_SIZE_LIMIT=52428800

############ Studio / Kong ############
STUDIO_DEFAULT_ORGANIZATION=Consultorio UAC
STUDIO_DEFAULT_PROJECT=consultorio
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############ Pooler (Supavisor) — si se mantiene ############
POOLER_TENANT_ID=consultorio
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
SECRET_KEY_BASE=cambiar-cadena-larga-aleatoria
VAULT_ENC_KEY=cambiar-clave-de-32-caracteres-fijos

############ Analytics (Logflare) — opcional ############
LOGFLARE_PUBLIC_ACCESS_TOKEN=cambiar
LOGFLARE_PRIVATE_ACCESS_TOKEN=cambiar
